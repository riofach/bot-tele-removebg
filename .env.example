# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN="YOUR_BOT_TOKEN"

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Simple API Key Authentication (untuk internal team)
API_KEY="your-simple-api-key-here"

# Rate Limiting (tanpa Redis)
RATE_LIMIT_PER_MINUTE=30

# File Upload Limits
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=["image/jpeg", "image/png", "image/jpg"]

# CORS Origins (Next.js URLs)
CORS_ORIGINS=["http://localhost:3000", "https://your-nextjs-domain.com"]
