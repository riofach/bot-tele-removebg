									"console.log('Rate limit test iteration:', iteration);"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"const iteration = pm.globals.get('rate_limit_iteration');",
									"",
									"if (iteration <= 30) {",
									"    pm.test('Request within rate limit - Status 200', function () {",
									"        pm.response.to.have.status(200);",
									"    });",
									"} else {",
									"    pm.test('Rate limit exceeded - Status 429', function () {",
									"        pm.expect([200, 429]).to.include(pm.response.code);",
									"    });",
									"    ",
									"    if (pm.response.code === 429) {",
									"        pm.test('Rate limit error message', function () {",
									"            const response = pm.response.json();",
									"            pm.expect(response.success).to.be.false;",
									"            pm.expect(response.error_code).to.eql('RATE_LIMIT_EXCEEDED');",
									"        });",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{BASE_URL}}/health",
							"host": ["{{BASE_URL}}"],
							"path": ["health"]
						}
					},
					"response": []
				}
			]
		}
	]
